@model List<EtiquetaVm>
@{ ViewData["Title"] = "Etiquetas"; }

<h1 class="h3 mb-3">Etiquetas</h1>

<div class="mb-3">
    <a asp-action="Crear" class="btn btn-primary">Nueva etiqueta</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Todavía no hay etiquetas.</div>
}
else
{
    <table class="table table-striped table-hover bg-white">
        <thead>
            <tr>
                <th>Id</th>
                <th>Etiqueta</th>
                <th>Color</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var etiqueta in Model)
            {
                <tr>
                    <td>@etiqueta.Id</td>
                    <td><partial name="_InsigniaColor" model="etiqueta" /></td>
                    <td><code>@etiqueta.Color</code></td>
                    <td><a asp-action="Detalle" asp-route-id="@etiqueta.Id">Ver detalle</a></td>
                </tr>
            }
        </tbody>
    </table>
}
